# ── Master DB (Neon PostgreSQL) ──────────────────────────────────
INFRA_MASTER_DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/infra?sslmode=require"

# ── Crypto ───────────────────────────────────────────────────────
# 32 bytes hex = 64 ky tu. Sinh bang: openssl rand -hex 32
INFRA_MASTER_ENCRYPTION_KEY=""

# ── Better Auth ──────────────────────────────────────────────────
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Platform administrators ──────────────────────────────────────
# Danh sach email duoc phep quan tri ha tang, cach nhau bang dau phay.
# KHONG sua duoc tu giao dien — day la lop bao ve doc lap voi database.
INFRA_SUPER_ADMIN_EMAILS="minkoi007.cs@gmail.com"

# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV="development"
INFRA_PUBLIC_URL="http://localhost:3000"
INFRA_LOG_LEVEL="info"
