# ── Master DB (Neon PostgreSQL) ──────────────────────────────────
INFRA_MASTER_DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/infra?sslmode=require"

# ── Crypto ───────────────────────────────────────────────────────
# 32 bytes hex = 64 ky tu. Sinh bang: openssl rand -hex 32
INFRA_MASTER_ENCRYPTION_KEY=""

# ── Better Auth ──────────────────────────────────────────────────
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Platform administrators ──────────────────────────────────────
# Danh sach email duoc phep quan tri ha tang, cach nhau bang dau phay.
# KHONG sua duoc tu giao dien — day la lop bao ve doc lap voi database.
INFRA_SUPER_ADMIN_EMAILS="minkoi007.cs@gmail.com"

# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV="development"
INFRA_PUBLIC_URL="http://localhost:3000"
INFRA_LOG_LEVEL="info"

# Token cho cac endpoint noi bo ma scheduler goi (/api/internal/*).
# Chua dat = khong ai goi duoc - cua dong, khong phai cua mo. Sinh bang: openssl rand -base64 48
INFRA_INTERNAL_TOKEN=""

# Provisioning tu dong (Phase 6). Thieu thi tinh nang tat, khong lam sap tien trinh.
NEON_API_KEY=""
NEON_REGION="aws-us-east-2"
TURSO_API_TOKEN=""
TURSO_ORGANIZATION=""
TURSO_GROUP="default"

# Mail. Chua dat = luong khoi phuc mat khau NEM LOI va log to, khong im lang bo qua.
#   console  -> in link ra console (dev)
#   resend   -> can INFRA_MAIL_API_KEY + INFRA_MAIL_FROM
#   webhook  -> can INFRA_MAIL_WEBHOOK_URL (SMTP relay cua rieng ban)
INFRA_MAIL_PROVIDER="console"
INFRA_MAIL_API_KEY=""
INFRA_MAIL_FROM=""
INFRA_MAIL_WEBHOOK_URL=""
