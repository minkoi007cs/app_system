{
  "name": "unified-app-infra",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @infra/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @infra/db exec drizzle-kit migrate",
    "db:studio": "pnpm --filter @infra/db exec drizzle-kit studio",
    "smoke": "tsx scripts/smoke-multi-provider.mts",
    "verify:schema": "pnpm --filter @infra/db exec tsx scripts/verify-schema.mts"
  },
  "devDependencies": {
    "@infra/adapters": "workspace:^",
    "@infra/core": "workspace:^",
    "@infra/db": "workspace:^",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}